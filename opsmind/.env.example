# Copy to .env and fill in. .env is git-ignored; never commit real keys.
#
# LLM tiers form an ordered failover chain: tier 1 is tried first, and a later tier is
# reached only when every tier before it fails (transport down, rate limited, credit
# exhausted, malformed tool call). Each tier is any OpenAI-compatible endpoint.
#
# The shipped default is cloud-first with a local Ollama backstop:
#
#   tier 1  Cerebras   fast, free tier, serves nearly all traffic
#   tier 2  Groq       second cloud provider, different quota pool
#   tier 3  Ollama     local; slower, but never rate-limited and never out of credit
#
# That ordering means survey content reaches a third-party provider in normal operation.
# For an air-gapped install, disable tiers 1 and 2 and run Ollama alone — see README.

# ---------------------------------------------------------------- tier 1 · Cerebras
LLM_TIER1_ENABLED=true
LLM_TIER1_BASE_URL=https://api.cerebras.ai/v1
LLM_TIER1_API_KEY=
LLM_TIER1_MODEL=llama-3.3-70b
LLM_TIER1_TIMEOUT_SECONDS=120

# ---------------------------------------------------------------- tier 2 · Groq
LLM_TIER2_ENABLED=false
LLM_TIER2_BASE_URL=https://api.groq.com/openai/v1
LLM_TIER2_API_KEY=
LLM_TIER2_MODEL=llama-3.3-70b-versatile
LLM_TIER2_TIMEOUT_SECONDS=120

# ---------------------------------------------------------------- tier 3 · Ollama (local)
# Reached only when both cloud tiers fail. docker-compose runs Ollama as a service, so
# the in-network URL is http://ollama:11434/v1; use http://localhost:11434/v1 when running
# the backend outside compose. No API key — Ollama is keyless.
#
# The timeout is deliberately larger than the cloud tiers': a CPU-served model can take
# minutes on a cold load. OLLAMA_KEEP_ALIVE in docker-compose.yml keeps the model resident
# so that cost is paid once at startup rather than on every turn after an idle gap.
LLM_TIER3_ENABLED=true
LLM_TIER3_BASE_URL=http://ollama:11434/v1
LLM_TIER3_API_KEY=
LLM_TIER3_MODEL=llama3.1:8b
LLM_TIER3_TIMEOUT_SECONDS=300

# Which model docker-compose pulls into the Ollama service at startup. Keep it in step
# with LLM_TIER3_MODEL — a mismatch means tier 3 404s at exactly the moment the cloud
# tiers have already failed, which is the worst time to discover it.
OLLAMA_MODEL=llama3.1:8b

# Postgres dev credentials are set by docker-compose (opsmind/opsmind); no need
# to change them for local development.
