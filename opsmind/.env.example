# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Anthropic — required for the LLM features (NL template generation + the
# conversational runner). The scaffold and CRUD run without it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Backup LLMs — an ordered failover chain after Anthropic. Each is any OpenAI-compatible
# endpoint (Cerebras, Groq, OpenRouter, vLLM, NIM, Ollama, ...). The first backup is tried
# when the primary fails, the second when the first also fails; if the Anthropic key above
# is blank, the chain simply leads with the first backup. Leave a tier disabled to skip it.
LLM_BACKUP_ENABLED=false
LLM_BACKUP_BASE_URL=
LLM_BACKUP_API_KEY=
LLM_BACKUP_MODEL=
# Read timeout for backup calls. Local CPU models can need >60s on a cold load;
# raise this (e.g. 300) for slow hardware. Unreachable endpoints still fail fast.
LLM_BACKUP_TIMEOUT_SECONDS=120

# Second backup, tried only when both the primary and the first backup fail.
LLM_BACKUP2_ENABLED=false
LLM_BACKUP2_BASE_URL=
LLM_BACKUP2_API_KEY=
LLM_BACKUP2_MODEL=
LLM_BACKUP2_TIMEOUT_SECONDS=120

# Third backup, tried only when the primary and both prior backups fail.
LLM_BACKUP3_ENABLED=false
LLM_BACKUP3_BASE_URL=
LLM_BACKUP3_API_KEY=
LLM_BACKUP3_MODEL=
LLM_BACKUP3_TIMEOUT_SECONDS=120

# Postgres dev credentials are set by docker-compose (opsmind/opsmind); no need
# to change them for local development.
