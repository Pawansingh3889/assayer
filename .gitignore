# Repository-root ignores. opsmind/.gitignore covers its own subtree and still
# applies from here; this file covers the root and adds the editor-backup patterns
# that let backup.py.bak, backup.py.backup and pyproject.toml.bak get committed.

# Editor / tooling backups
*.bak
*.backup
*.orig
*.rej
*~

# Secrets / env
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# OS / editor
.DS_Store
__MACOSX/
._*
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
*.log

# Local-only compose overrides (publishes the DB port for GUI access)
docker-compose.dbport.yml
docker-compose.override.yml
